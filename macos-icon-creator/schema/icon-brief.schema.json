{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "macOS Icon Brief",
  "description": "Concise design brief paired with a macOS app icon SVG.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app_concept",
    "primary_metaphor",
    "composition_family"
  ],
  "properties": {
    "app_concept": {
      "type": "string",
      "description": "Short description of the product or feature the icon represents."
    },
    "primary_metaphor": {
      "type": "string",
      "description": "Main object or scene that anchors the icon."
    },
    "supporting_motifs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Secondary cues that serve the primary metaphor; omit unnecessary motifs."
    },
    "composition_family": {
      "type": "string",
      "examples": [
        "centered-object-with-base",
        "diagonal-object",
        "layered-plate",
        "floating-tool",
        "edge-pressure-object",
        "fused-with-base",
        "breakout-corner",
        "perched-on-stage",
        "inset-object-with-overlap"
      ],
      "description": "Short composition label; examples are illustrative, not an exhaustive set.",
      "minLength": 1
    },
    "tone": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "palette_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "include_symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoid_symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "small_size_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
